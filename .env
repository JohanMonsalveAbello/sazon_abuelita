# Copia este archivo como .env y ajústalo a tu equipo. Nunca subas .env al repositorio.
APP_NAME="El Sazón de la Abuela"
# local | production
APP_ENV=production
# true muestra detalles técnicos en pantalla. Déjalo en false durante la evaluación.
APP_DEBUG=false
APP_TIMEZONE=America/Bogota

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sazon_abuelita
DB_USER=root
DB_PASS=

# Segundos de inactividad antes de cerrar la sesión (1800 = 30 minutos)
SESSION_IDLE_SECONDS=1800
